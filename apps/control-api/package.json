{
  "name": "@polymarket-bot/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control API (WP-240): the §4.1 layer-3 process that owns authenticated operational controls and read APIs, and NEVER has the signing key. PAPER only — strategy pause/resume, §14.1 kill-switch scopes, run-state reads, an append-only audit of every mutation, and the Prometheus surface the operations/trading/fidelity dashboards read. No signer, no venue connection, no order path, and no request that can raise a run mode.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../test/integration/control-api/tsconfig.json",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --alias:crypto=./src/driver-shims/crypto --alias:dns=./src/driver-shims/dns --alias:events=./src/driver-shims/events --alias:fs=./src/driver-shims/fs --alias:net=./src/driver-shims/net --alias:path=./src/driver-shims/path --alias:stream=./src/driver-shims/stream --alias:string_decoder=./src/driver-shims/string_decoder --alias:tls=./src/driver-shims/tls --alias:util=./src/driver-shims/util --alias:pg-native=./src/driver-shims/pg-native.ts --outfile=dist/main.mjs",
    "start": "pnpm run typecheck && pnpm run build && node ./dist/main.mjs",
    "test:integration": "vitest run --config ../../test/integration/control-api/vitest.config.ts",
    "test:integration:postgres": "vitest run --config ../../test/integration/control-api/postgres/vitest.config.ts"
  },
  "dependencies": {
    "@polymarket-bot/domain": "workspace:*",
    "@polymarket-bot/observability": "workspace:*",
    "@polymarket-bot/risk": "workspace:*",
    "@polymarket-bot/storage-postgres": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
