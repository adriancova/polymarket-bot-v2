{
  "name": "@polymarket-bot/event-bus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bounded transport for normalized market events (WP-060): the transport-neutral publish / subscribe / consumer-checkpoint / bounded-retention interface, and its Redis Streams implementation.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../test/integration/event-bus/tsconfig.json",
    "test:integration": "vitest run --config ../../test/integration/event-bus/vitest.config.ts"
  },
  "dependencies": {
    "@polymarket-bot/domain": "workspace:*",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
