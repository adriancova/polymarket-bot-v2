{
  "name": "@polymarket-bot/polymarket-public",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public, unauthenticated Polymarket market-data adapter (WP-070): market WebSocket client, subscription manager, REST book snapshot fetcher, and normalization into the frozen domain events. No credential, signer, or order path exists here.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rtds": "./src/rtds/index.ts",
    "./market-state": "./src/market-state/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../test/contract/polymarket-public/tsconfig.json && tsc --noEmit -p ../../test/contract/rtds/tsconfig.json",
    "test:contract": "vitest run --config ../../test/contract/polymarket-public/vitest.config.ts",
    "test:contract:rtds": "vitest run --config ../../test/contract/rtds/vitest.config.ts"
  },
  "dependencies": {
    "@polymarket-bot/decimal": "workspace:*",
    "@polymarket-bot/domain": "workspace:*",
    "@polymarket-bot/risk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
